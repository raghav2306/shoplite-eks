# Template: copy to secret.yaml (git-ignored) and set real values.
# SMTP credentials for the server in notification-service-config, e.g. Amazon
# SES SMTP credentials (SES console > SMTP settings > Create SMTP credentials).
# These are not your AWS access keys.
apiVersion: v1
kind: Secret
metadata:
  name: notification-service-secret
  namespace: ecommerce
type: Opaque
stringData:
  SMTP_USER: "replace-with-smtp-username"
  SMTP_PASS: "replace-with-smtp-password"
