# Copy to terraform.tfvars (git-ignored) and adjust. Every value is optional.

region             = "us-east-1"
cluster_name       = "ecommerce"
# A version past standard support costs 6x for the control plane (extended support)
kubernetes_version = "1.37" # aws eks describe-cluster-versions --query 'clusterVersions[].[clusterVersion,versionStatus]'

# Restrict kubectl access to your IP (curl -s https://checkip.amazonaws.com)
# cluster_endpoint_public_access_cidrs = ["203.0.113.7/32"]

# Nodes
# node_instance_type = "t3.medium"
# node_desired_size  = 2
# node_min_size      = 2
# node_max_size      = 4
